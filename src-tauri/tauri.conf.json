{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tantalus",
  "version": "0.0.10",
  "identifier": "dev.arnab.tantalus",
  "build": {
    "beforeDevCommand": "vp dev",
    "beforeBuildCommand": "vp build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "width": 480, "height": 590, "minWidth": 360, "minHeight": 500, "resizable": true, "create": false, "visible": true, "backgroundColor": "#fbf8f1" }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4Q0M5ODY5MTI1MDVEQjgKUldTNFhWQVNhWmpNU0N5VXJlQVYxNGppUHZrZTJFVVFKZzcyQWxKY2xqVUJYOU5WTDVyVW41MkUK",
      "endpoints": ["https://github.com/zytact/tantalus/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
