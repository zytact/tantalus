{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tantalus",
  "version": "0.0.3",
  "identifier": "dev.arnab.tantalus",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tantalus",
        "width": 480,
        "height": 590,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true,
        "visible": true,
        "backgroundColor": "#fbf8f1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
